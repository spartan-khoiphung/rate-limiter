  "cards": [
    {
      "dot": "cyan",
      "title": "Why release before sleeping",
      "items": [
        "A held lease sends no heartbeat while the thread sleeps",
        "Releasing first means a long park can't make this worker look dead and lose leases it wasn't even parking on"
      ]
    },
    {
      "dot": "rose",
      "title": "Why stop trusting retryAfter after 2 tries",
      "items": [
        "A short retryAfter that still ends in a 429 means the vendor's number doesn't match reality",
        "consecutiveParks resets to 0 on the next successful batch \u2014 this only kicks in while the window is genuinely still saturated"
      ]
    }
  ]
